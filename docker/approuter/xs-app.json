{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "sessionTimeout": 480,
  "responseHeaders": [
    {
      "name": "Cache-Control",
      "value": "no-cache, no-store, must-revalidate"
    },
    {
      "name": "Pragma",
      "value": "no-cache"
    },
    {
      "name": "Expires",
      "value": "0"
    }
  ],
  "routes": [
    {
      "source": "^/api/(.*)$",
      "target": "/api/$1",
      "destination": "backend",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/assets/(.*)$",
      "localDir": "resources",
      "authenticationType": "none"
    },
    {
      "source": "^/(.*)$",
      "target": "/index.html",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    }
  ],
  "logout": {
    "logoutEndpoint": "/logout",
    "logoutPage": "/"
  }
}
