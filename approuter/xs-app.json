{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "sessionTimeout": 30,
  "routes": [
    {
      "source": "^/api/(.*)$",
      "target": "/api/$1",
      "destination": "backend",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/assets/(.*)$",
      "target": "/assets/$1",
      "localDir": "app/assets",
      "authenticationType": "none",
      "cacheControl": "public, max-age=31536000, immutable"
    },
    {
      "source": "^/.*\\.(js|css|png|jpg|jpeg|svg|ico|woff|woff2|ttf|eot)$",
      "localDir": "app",
      "authenticationType": "none",
      "cacheControl": "public, max-age=31536000, immutable"
    },
    {
      "source": "^/(.*)$",
      "target": "/index.html",
      "localDir": "app",
      "authenticationType": "xsuaa"
    }
  ],
  "destinations": [
    {
      "name": "backend",
      "url": "http://slate-backend:5055",
      "forwardAuthToken": true,
      "strictSSL": false
    }
  ],
  "compression": {
    "enabled": true
  }
}
