# ============================================================================
# Open Notebook - Environment Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------------------------------

# Database type: sqlite | hana
DATABASE_TYPE=sqlite

# SQLite Configuration (Development)
SQLITE_DB_PATH=backend/data/database.db
SQLITE_POOL_SIZE=5
SQLITE_MAX_OVERFLOW=10
SQLITE_POOL_TIMEOUT=30

# HANA Cloud Configuration (Production)
# Uncomment and configure when using HANA
# HANA_HOST=your-instance.hanacloud.ondemand.com
# HANA_PORT=443
# HANA_DATABASE=SYSTEMDB
# HANA_USER=your_username
# HANA_PASSWORD=your_password
# HANA_ENCRYPT=true
# HANA_SSL_VALIDATE_CERT=true
# HANA_POOL_SIZE=10
# HANA_MAX_OVERFLOW=20
# HANA_POOL_TIMEOUT=30

# ----------------------------------------------------------------------------
# SECURITY
# ----------------------------------------------------------------------------

# Encryption key for credentials (REQUIRED - min 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OPEN_NOTEBOOK_ENCRYPTION_KEY=your-encryption-key-min-32-chars-change-this

# Basic authentication password (optional)
BASIC_AUTH_PASSWORD=

# ----------------------------------------------------------------------------
# API CONFIGURATION
# ----------------------------------------------------------------------------

API_HOST=127.0.0.1
API_PORT=5055
API_RELOAD=true

# ----------------------------------------------------------------------------
# AI PROVIDERS (Optional - at least one recommended)
# ----------------------------------------------------------------------------

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google
GOOGLE_API_KEY=

# Groq
GROQ_API_KEY=

# Add more providers as needed...

# ----------------------------------------------------------------------------
# FRONTEND (if running separately)
# ----------------------------------------------------------------------------

NEXT_PUBLIC_API_URL=http://localhost:5055/api
