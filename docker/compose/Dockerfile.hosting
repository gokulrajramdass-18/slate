FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY backend/requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

# Copy application code
COPY backend/open_notebook/ ./open_notebook/
COPY backend/api/ ./api/

# Set environment
ENV DEPLOYMENT_ENV=production
ENV HOSTING_PORT=5056

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:5056/health || exit 1

# Run hosting server
CMD ["python", "-m", "uvicorn", "api.hosting_server:app", "--host", "0.0.0.0", "--port", "5056"]
