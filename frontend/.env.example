# API Configuration
# Backend API base URL (without /api suffix)
VITE_API_URL=http://localhost:5055

# Basic Auth Password (must match backend)
VITE_BASIC_AUTH_PASSWORD=your_secure_password_here

# HAI Proxy Key - prepopulated for LiteLLM import (optional)
VITE_HAI_PROXY_KEY=your_hai_proxy_key_here
