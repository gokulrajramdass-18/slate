{
  "authenticationMethod": "route",
  "sessionTimeout": 480,
  "routes": [
    {
      "source": "^/api/models/litellm/models(.*)$",
      "target": "/api/models/litellm/models$1",
      "destination": "backend",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/api/models/sap-ai-core/(.*)$",
      "target": "/api/models/sap-ai-core/$1",
      "destination": "backend",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/api/credentials/test-connection$",
      "target": "/api/credentials/test-connection",
      "destination": "backend",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/api/mcp-servers/([^/]+)/oauth/callback(.*)$",
      "target": "/api/mcp-servers/$1/oauth/callback$2",
      "destination": "backend",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/api/(.*)$",
      "target": "/api/$1",
      "destination": "backend",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/(.*)$",
      "target": "/$1",
      "destination": "frontend",
      "authenticationType": "xsuaa"
    }
  ],
  "logout": {
    "logoutEndpoint": "/logout",
    "logoutPage": "/"
  }
}
