# Production values for grtest-ns namespace
# Copy this file to values-grtest.yaml (gitignored) and fill in real credentials.

namespace: grtest-ns

global:
  domain: c-83567d2.kyma.ondemand.com

backend:
  image:
    repository: gokulraj18/slate-backend
    tag: kyma-v1.0.0
    pullPolicy: Always

  persistence:
    enabled: true
    size: 20Gi

  resources:
    limits:
      cpu: 2000m
      memory: 4Gi
    requests:
      cpu: 1000m
      memory: 2Gi

sapAiCoreApi:
  enabled: true
  image:
    repository: gokulraj18/slate-sap-ai-core-api
    tag: v1.0.0
    pullPolicy: Always

  # IMPORTANT: SAP AI Core service-key values. Do NOT commit real credentials.
  credentials:
    authUrl: "https://<your-subaccount>.authentication.<region>.hana.ondemand.com"
    clientId: "<REPLACE_WITH_AICORE_CLIENT_ID>"
    clientSecret: "<REPLACE_WITH_AICORE_CLIENT_SECRET>"
    baseUrl: "https://api.ai.<region>.<provider>.ml.hana.ondemand.com"
    resourceGroup: "<REPLACE_WITH_AICORE_RESOURCE_GROUP>"

approuter:
  replicaCount: 2
  image:
    repository: gokulraj18/slate-approuter
    tag: kyma-v1.0.0
    pullPolicy: Always

xsuaa:
  xsappname: slate-grtest
